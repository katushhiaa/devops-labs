apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: cert-app-servicemonitor
  namespace: {{ .Values.namespace | default "anurieva" }}
  labels:
    release: kps
spec:
  selector:
    matchLabels:
      app.kubernetes.io/instance: cert-app
      app.kubernetes.io/name: certific-generator
  endpoints:
    - port: http-backend
      path: /metrics
      interval: 15s